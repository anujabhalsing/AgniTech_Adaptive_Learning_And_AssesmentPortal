# SkillTrace AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# ─── Supabase (Auth + DB) ────────────────────────────────────────────────────
# Without these the app works in guest/demo mode using localStorage.
# 1. Create a free project at https://supabase.com
# 2. Go to Settings > API to find your project URL and anon key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Judge0 (Code Execution) ─────────────────────────────────────────────────
# Without this key the Coding page runs in demo mode.
# 1. Sign up at https://rapidapi.com/judge0-official/api/judge0-ce
# 2. Subscribe and copy your RapidAPI key
VITE_JUDGE0_API_KEY=your_judge0_rapidapi_key_here
VITE_JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# ─── OpenAI (AI re-explanations) ─────────────────────────────────────────────
# Optional. Core lessons and quizzes work without it.
# https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME=SkillTrace AI
VITE_APP_VERSION=2.0.0
