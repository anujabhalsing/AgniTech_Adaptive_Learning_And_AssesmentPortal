# SkillTrace AI — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Optional AI Integration ──────────────────────────────────────────────────
# If you add an AI API, the app will use it for:
#   - Explaining concepts at different difficulty levels
#   - Generating supplementary practice questions
#   - Creating personalised hints
#   - Generating viva questions from submitted code
# Without an API key, all built-in lessons and quizzes continue to work.

VITE_OPENAI_API_KEY=your_openai_api_key_here

# ── Optional: Code Execution Service ─────────────────────────────────────────
# Use a trusted sandbox API (e.g. Judge0, Piston) for running student code.
# Without this, the coding editor runs in demonstration mode only.
# NEVER expose execution API keys in frontend code — use a backend proxy.

VITE_JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
VITE_JUDGE0_API_KEY=your_judge0_api_key_here

# ── Optional: Supabase (for multi-device accounts) ──────────────────────────
# Without Supabase, data is stored in the browser's localStorage (demo mode).

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── App Config ────────────────────────────────────────────────────────────────
VITE_APP_NAME=SkillTrace AI
VITE_APP_VERSION=1.0.0
